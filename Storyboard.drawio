<mxfile host="drawio"><diagram name="Storyboard" id="storyboard"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Cyberpunk Text Adventure - Storyboard" style="text;html=1;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="-70" width="900" height="40" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;: blue = story state &amp;nbsp;|&amp;nbsp; green = ending &amp;nbsp;|&amp;nbsp; red = game over &amp;nbsp;|&amp;nbsp; arrow label = key pressed (1-3) &amp;nbsp;|&amp;nbsp; red dashed = death &amp;nbsp;|&amp;nbsp; green = to ending &amp;nbsp;|&amp;nbsp; every ending and game over restarts at P1" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="-65" width="1700" height="30" as="geometry"/></mxCell><mxCell id="prologue" value="Chapter 0 - Prologue: Just Another Night (Kabuki, Watson)" style="swimlane;startSize=40;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#F6F9FF;swimlaneFillColor=#F6F9FF;strokeColor=#D5DAE1;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2580" height="740" as="geometry"/></mxCell><mxCell id="watson" value="Chapter 1 - Watson: The Shard" style="swimlane;startSize=40;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#F3FAF5;swimlaneFillColor=#F3FAF5;strokeColor=#D5DAE1;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="810" width="2580" height="970" as="geometry"/></mxCell><mxCell id="pacifica" value="Chapter 2A - Pacifica: The Voodoo Boys" style="swimlane;startSize=40;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFF7F2;swimlaneFillColor=#FFF7F2;strokeColor=#D5DAE1;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="1820" width="2580" height="970" as="geometry"/></mxCell><mxCell id="arasaka" value="Chapter 2B - Arasaka: The Offer" style="swimlane;startSize=40;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#FEF6F6;swimlaneFillColor=#FEF6F6;strokeColor=#D5DAE1;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="2830" width="2580" height="970" as="geometry"/></mxCell><mxCell id="badlands" value="Chapter 2C - Badlands: The Aldecaldos" style="swimlane;startSize=40;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFAF0;swimlaneFillColor=#FFFAF0;strokeColor=#D5DAE1;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="3840" width="2580" height="740" as="geometry"/></mxCell><mxCell id="blackwall" value="Chapter 3 - Beyond the Blackwall" style="swimlane;startSize=40;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#F3EEFF;swimlaneFillColor=#F3EEFF;strokeColor=#D5DAE1;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="4620" width="2580" height="740" as="geometry"/></mxCell><mxCell id="endings" value="Endings (all lead back to P1 - Play again)" style="swimlane;startSize=40;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#E7F6EC;swimlaneFillColor=#E7F6EC;strokeColor=#D5DAE1;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="0" y="5400" width="2580" height="280" as="geometry"/></mxCell><mxCell id="gameover" value="Game Over" style="swimlane;startSize=40;fontSize=18;fontStyle=1;fillColor=#FDECEC;swimlaneFillColor=#FEF6F6;strokeColor=#EBA3A3;html=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="2640" y="30" width="300" height="5650" as="geometry"/></mxCell><mxCell id="P1" value="&lt;b&gt;P1. Just Another Night&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You are in a bar in Kabuki, Watson. Nothing special, just a popular place on the streets of Night City, 2077. Neon...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Buy a drink (-5 eb) &lt;b&gt;&amp;gt; P2&lt;/b&gt;&lt;br&gt;2. Nah &lt;b&gt;&amp;gt; P3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="30" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;P2. Broseph Ale&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The bartender, Maggie, slides you a cold Broseph. You have 15 eb.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go talk to the fixer. &lt;b&gt;&amp;gt; P4&lt;/b&gt;&lt;br&gt;2. &amp;quot;What's the catch?&amp;quot; &lt;b&gt;&amp;gt; P7&lt;/b&gt;&lt;br&gt;3. Just drink. &lt;b&gt;&amp;gt; P5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="310" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="P3" value="&lt;b&gt;P3. Nah&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You keep your 20 eb and watch the room. Two Tyger Claws by the door, katanas on their backs. A man with glowing...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Walk over to the back booth. &lt;b&gt;&amp;gt; P4&lt;/b&gt;&lt;br&gt;2. Leave the bar. &lt;b&gt;&amp;gt; P6&lt;/b&gt;&lt;br&gt;3. Keep sitting. &lt;b&gt;&amp;gt; P5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="310" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="P4" value="&lt;b&gt;P4. The Fixer&lt;/b&gt;&lt;hr&gt;&lt;i&gt;&amp;quot;Kaz Okoro. Small-time fixer, big-time heart.&amp;quot; His optics click as they scan you. &amp;quot;Simple gig. Courier a package to...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;I'm in.&amp;quot; &lt;b&gt;&amp;gt; P8&lt;/b&gt;&lt;br&gt;2. &amp;quot;What's in the package?&amp;quot; &lt;b&gt;&amp;gt; P9&lt;/b&gt;&lt;br&gt;3. &amp;quot;Not interested.&amp;quot; &lt;b&gt;&amp;gt; P5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="590" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="P5" value="&lt;b&gt;P5. Last Delivery&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The door slams open. A netrunner in a sweat-soaked cooling suit staggers in and collapses at your feet. She presses...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Pocket the shard and run for the back d.. &lt;b&gt;&amp;gt; W1&lt;/b&gt;&lt;br&gt;2. Call Trauma Team! &lt;b&gt;&amp;gt; P10&lt;/b&gt;&lt;br&gt;3. Hand the shard to the Tyger Claws. &lt;b&gt;&amp;gt; P11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="1150" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="P6" value="&lt;b&gt;P6. Kabuki Streets&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Outside, the night market steams: noodle stands, cheap chrome, a Delamain cab gliding past. A netrunner bursts out...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Run. &lt;b&gt;&amp;gt; W1&lt;/b&gt;&lt;br&gt;2. Toss the shard into a trash compactor. &lt;b&gt;&amp;gt; X1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="590" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="P7" value="&lt;b&gt;P7. Maggie's Rumor&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Maggie lowers her voice. &amp;quot;Word is NetWatch agents have been sniffing around Kabuki all week. Somebody pulled...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Talk to the fixer anyway. &lt;b&gt;&amp;gt; P4&lt;/b&gt;&lt;br&gt;2. Finish your drink and mind your business. &lt;b&gt;&amp;gt; P5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="590" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="P8" value="&lt;b&gt;P8. Waiting for Nix&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Kaz shakes your hand. &amp;quot;Nix was supposed to bring the package an hour ago. She's never late.&amp;quot; He checks his holo. Frowns.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Look toward the door. &lt;b&gt;&amp;gt; P5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="870" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="P9" value="&lt;b&gt;P9. Old Data&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Kaz leans back. &amp;quot;Data, choom. Old data. From before the DataKrash. The kind NetWatch would burn a whole block to bury.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;Yeah, I'm in.&amp;quot; &lt;b&gt;&amp;gt; P8&lt;/b&gt;&lt;br&gt;2. &amp;quot;Hard pass.&amp;quot; &lt;b&gt;&amp;gt; P5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="870" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="P10" value="&lt;b&gt;P10. No Coverage&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You ping Trauma Team. A cheerful voice: &amp;quot;No active subscription detected for the patient. Have a safe night!&amp;quot; Click.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Run with the shard. &lt;b&gt;&amp;gt; W1&lt;/b&gt;&lt;br&gt;2. Stay and wait for NCPD. &lt;b&gt;&amp;gt; W2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="1430" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="P11" value="&lt;b&gt;P11. Bad Trade&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A Claw grabs the shard and slots it straight into his neck. His eyes flood with static. He screams, draws his pistol...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Grab the shard and run. &lt;b&gt;&amp;gt; W1&lt;/b&gt;&lt;br&gt;2. Hide behind the bar and wait. &lt;b&gt;&amp;gt; X2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="prologue"><mxGeometry x="1430" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="W1" value="&lt;b&gt;W1. Back Alley&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Rain, trash, a flickering Kang Tao ad. The shard is still warm in your hand, and your personal link pings: UNKNOWN...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Slot the shard. &lt;b&gt;&amp;gt; W3&lt;/b&gt;&lt;br&gt;2. Call Kaz the fixer. &lt;b&gt;&amp;gt; W4&lt;/b&gt;&lt;br&gt;3. Run for the NCART station. &lt;b&gt;&amp;gt; W6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="30" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="W2" value="&lt;b&gt;W2. NCPD Interrogation&lt;/b&gt;&lt;hr&gt;&lt;i&gt;An NCPD officer scans your ID with a bored face. &amp;quot;Dead netrunner, chromed-up gangers, and you. Funny. Anything to...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Lie: &amp;quot;I saw nothing.&amp;quot; &lt;b&gt;&amp;gt; W1&lt;/b&gt;&lt;br&gt;2. Tell the truth and hand it over. &lt;b&gt;&amp;gt; R1&lt;/b&gt;&lt;br&gt;3. Offer him your eb. &lt;b&gt;&amp;gt; W6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="30" y="750" width="240" height="190" as="geometry"/></mxCell><mxCell id="W3" value="&lt;b&gt;W3. Mirage&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Your vision glitches. Then a voice, inside your head: &amp;quot;...Hello? You're not Nix.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;What exactly are you?&amp;quot; &lt;b&gt;&amp;gt; W5&lt;/b&gt;&lt;br&gt;2. Eject the shard, now! &lt;b&gt;&amp;gt; W7&lt;/b&gt;&lt;br&gt;3. &amp;quot;Is someone after me?&amp;quot; &lt;b&gt;&amp;gt; W8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="310" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="W4" value="&lt;b&gt;W4. Holocall: Kaz&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Kaz's face flickers up. &amp;quot;You got Nix's shard? Gonk! Every corp in this city wants it. Arasaka's offering 50,000 eb....&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go to Kaz's garage. &lt;b&gt;&amp;gt; W10&lt;/b&gt;&lt;br&gt;2. &amp;quot;Forget it, I'm out.&amp;quot; Hang up. &lt;b&gt;&amp;gt; W6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="310" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="W5" value="&lt;b&gt;W5. Behind the Wall&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Mirage explains. In 2022, Rache Bartmoss's viruses wrecked the old Net - the DataKrash. Rogue AIs took over what was...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;Okay. I'll help you.&amp;quot; &lt;b&gt;&amp;gt; W8&lt;/b&gt;&lt;br&gt;2. &amp;quot;Sorry. I'm selling you.&amp;quot; &lt;b&gt;&amp;gt; W4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="590" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="W6" value="&lt;b&gt;W6. NCART Station&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Kabuki station. Commuters, ads, NCPD drones scanning faces. Your face isn't flagged. Yet.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Take the south line to Pacifica. &lt;b&gt;&amp;gt; V1&lt;/b&gt;&lt;br&gt;2. Take the north line to Northside. &lt;b&gt;&amp;gt; W12&lt;/b&gt;&lt;br&gt;3. Grab a Delamain cab. &lt;b&gt;&amp;gt; W14&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="1150" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="W7" value="&lt;b&gt;W7. Eject Failed&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You yank at the shard. It won't move. Pain shoots behind your eyes.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Force it out. &lt;b&gt;&amp;gt; X3&lt;/b&gt;&lt;br&gt;2. Stop. Let go. &lt;b&gt;&amp;gt; W8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="590" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="W8" value="&lt;b&gt;W8. NetWatch Trace&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Red text crawls across your HUD: NETWATCH TRACE 37%.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Find a ripperdoc in Kabuki. &lt;b&gt;&amp;gt; W9&lt;/b&gt;&lt;br&gt;2. Call Kaz for help. &lt;b&gt;&amp;gt; W4&lt;/b&gt;&lt;br&gt;3. Ignore it. It's probably fine. &lt;b&gt;&amp;gt; X4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="590" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="W9" value="&lt;b&gt;W9. Doc Mori's Clinic&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A ripperdoc den behind a noodle shop. Doc Mori looks at your HUD. &amp;quot;Military-grade ICE. 300 eb.&amp;quot; You don't have...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Take the job in Northside. &lt;b&gt;&amp;gt; W12&lt;/b&gt;&lt;br&gt;2. Grab the ICE chip and run. &lt;b&gt;&amp;gt; X5&lt;/b&gt;&lt;br&gt;3. Leave. &lt;b&gt;&amp;gt; W6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="870" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="W10" value="&lt;b&gt;W10. Kaz's Garage&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Kaz waits by a battered Quadra. Next to him stands a woman in a perfect black suit. Arasaka.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go with her quietly. &lt;b&gt;&amp;gt; R1&lt;/b&gt;&lt;br&gt;2. Run. &lt;b&gt;&amp;gt; W14&lt;/b&gt;&lt;br&gt;3. &amp;quot;Mirage, do something!&amp;quot; &lt;b&gt;&amp;gt; W11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="870" y="750" width="240" height="190" as="geometry"/></mxCell><mxCell id="W11" value="&lt;b&gt;W11. Short Circuit&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Mirage fires a quickhack: Reboot Optics. Both of them stumble around blind, cursing. You grab the Quadra's keys off...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Take the car and go. &lt;b&gt;&amp;gt; W15&lt;/b&gt;&lt;br&gt;2. Make Kaz talk. &lt;b&gt;&amp;gt; W16&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="1150" y="750" width="240" height="190" as="geometry"/></mxCell><mxCell id="W12" value="&lt;b&gt;W12. Maelstrom Turf&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Northside. The old All Foods plant hums with red light. Maelstrom gangers with more chrome than skin guard the gate....&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Sneak in while Mirage blinds the cameras. &lt;b&gt;&amp;gt; W13&lt;/b&gt;&lt;br&gt;2. Offer the shard to their boss. &lt;b&gt;&amp;gt; X6&lt;/b&gt;&lt;br&gt;3. Go in guns blazing. &lt;b&gt;&amp;gt; X7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="1150" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="W13" value="&lt;b&gt;W13. The Crate&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You slip in, grab the crate, slip out. A Maelstrom turret swivels - then turns on its own gang. Mirage giggles.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Think about it. &lt;b&gt;&amp;gt; W16&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="1430" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="W14" value="&lt;b&gt;W14. Delamain&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The cab's AI speaks in a polite British voice. &amp;quot;Good evening. I must note there is an unregistered intelligence on...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;Pacifica.&amp;quot; &lt;b&gt;&amp;gt; V1&lt;/b&gt;&lt;br&gt;2. &amp;quot;The Badlands.&amp;quot; &lt;b&gt;&amp;gt; N1&lt;/b&gt;&lt;br&gt;3. &amp;quot;Just get me out of Watson.&amp;quot; &lt;b&gt;&amp;gt; W15&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="1430" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="W15" value="&lt;b&gt;W15. Watson Checkpoint&lt;/b&gt;&lt;hr&gt;&lt;i&gt;NCPD barricades block the bridge out of Watson. Officers scan every vehicle. Your face is now flagged: WANTED FOR...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Floor it through the barricade. &lt;b&gt;&amp;gt; X8&lt;/b&gt;&lt;br&gt;2. Let Mirage spoof your ID. &lt;b&gt;&amp;gt; W16&lt;/b&gt;&lt;br&gt;3. Turn around. &lt;b&gt;&amp;gt; W6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="1430" y="750" width="240" height="190" as="geometry"/></mxCell><mxCell id="W16" value="&lt;b&gt;W16. Three Doors&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You stop somewhere dark to think. Three paths:&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Pacifica - the Voodoo Boys. &lt;b&gt;&amp;gt; V1&lt;/b&gt;&lt;br&gt;2. Arasaka. &lt;b&gt;&amp;gt; R1&lt;/b&gt;&lt;br&gt;3. The Badlands - the Aldecaldos. &lt;b&gt;&amp;gt; N1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="watson"><mxGeometry x="1710" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="V1" value="&lt;b&gt;V1. Pacifica&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Pacifica: the resort district investors abandoned halfway through building it. Unfinished hotels, dead neon, a...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Ask some street kids where the Voodoo B.. &lt;b&gt;&amp;gt; V2&lt;/b&gt;&lt;br&gt;2. Walk into the half-built mall. &lt;b&gt;&amp;gt; V3&lt;/b&gt;&lt;br&gt;3. Cut through the Combat Zone. &lt;b&gt;&amp;gt; X9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="30" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="V2" value="&lt;b&gt;V2. Street Kids&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Three kids sit on a burned-out car. &amp;quot;Voodoo Boys? Maybe we know. Maybe we want 10 eb.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Pay 10 eb. &lt;b&gt;&amp;gt; V4&lt;/b&gt;&lt;br&gt;2. &amp;quot;I'll find them myself.&amp;quot; &lt;b&gt;&amp;gt; V3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="310" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="V3" value="&lt;b&gt;V3. The Mall&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Inside the dead mall, two Voodoo Boys step out of the shadows, pistols lazy in their hands. &amp;quot;Wrong place, stranger.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Show them the shard. &lt;b&gt;&amp;gt; V4&lt;/b&gt;&lt;br&gt;2. &amp;quot;Kaz Okoro sent me.&amp;quot; &lt;b&gt;&amp;gt; V5&lt;/b&gt;&lt;br&gt;3. Try to sneak past. &lt;b&gt;&amp;gt; X10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="310" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="V4" value="&lt;b&gt;V4. The Church&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A tall Voodoo Boy named Baptiste walks you to an old church. Inside: cables, servers, and netrunners lying in ice...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Follow him. &lt;b&gt;&amp;gt; V6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="590" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="V5" value="&lt;b&gt;V5. The Test&lt;/b&gt;&lt;hr&gt;&lt;i&gt;&amp;quot;A fixer?&amp;quot; Baptiste spits. &amp;quot;We don't trust fixers. Want to talk to us? Prove it. The Animals in the next block stole...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;Deal.&amp;quot; &lt;b&gt;&amp;gt; V7&lt;/b&gt;&lt;br&gt;2. &amp;quot;Forget it.&amp;quot; &lt;b&gt;&amp;gt; V1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="590" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="V6" value="&lt;b&gt;V6. Celestine&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Celestine, the Voodoo Boys' best netrunner, scans the shard. Her eyes widen.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;Let's do it.&amp;quot; &lt;b&gt;&amp;gt; V8&lt;/b&gt;&lt;br&gt;2. &amp;quot;What happens to Mirage?&amp;quot; &lt;b&gt;&amp;gt; V9&lt;/b&gt;&lt;br&gt;3. &amp;quot;No.&amp;quot; Leave. &lt;b&gt;&amp;gt; V10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="870" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="V7" value="&lt;b&gt;V7. Animal House&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The Animals' gym stinks of sweat and growth hormones. Huge bodies, muscle grafts, zero necks. The codes are on a...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Fight your way through. &lt;b&gt;&amp;gt; X11&lt;/b&gt;&lt;br&gt;2. Let Mirage kill the lights and sneak in. &lt;b&gt;&amp;gt; V11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="870" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="V8" value="&lt;b&gt;V8. Ice Bath&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You climb into an ice bath. Cables click into your ports. Celestine: &amp;quot;The dive goes through an old gate near the...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Jack in. &lt;b&gt;&amp;gt; F1&lt;/b&gt;&lt;br&gt;2. Wait - ask Mirage first. &lt;b&gt;&amp;gt; V9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="1150" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="V9" value="&lt;b&gt;V9. Mirage's Fear&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Mirage, quietly: &amp;quot;They don't want to send me home. They want to use me as a key. Once the gate is open, they won't...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Trust the Voodoo Boys anyway. &lt;b&gt;&amp;gt; F1&lt;/b&gt;&lt;br&gt;2. Tell Celestine what Mirage said. &lt;b&gt;&amp;gt; V12&lt;/b&gt;&lt;br&gt;3. Sneak out of the church. &lt;b&gt;&amp;gt; V10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="1150" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="V10" value="&lt;b&gt;V10. Agent Voss&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Outside, a man in a grey coat leans on a black car. No gang colors. No corp logo. &amp;quot;Agent Voss, NetWatch. Give me the...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Hand it over. &lt;b&gt;&amp;gt; S3&lt;/b&gt;&lt;br&gt;2. Run. &lt;b&gt;&amp;gt; V14&lt;/b&gt;&lt;br&gt;3. Go back into the church. &lt;b&gt;&amp;gt; V6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="1150" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="V11" value="&lt;b&gt;V11. Codes Recovered&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Lights out. You grab the codes while the Animals crash into each other in the dark. Mirage locks their boss in his...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go to the church. &lt;b&gt;&amp;gt; V4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="870" y="750" width="240" height="190" as="geometry"/></mxCell><mxCell id="V12" value="&lt;b&gt;V12. Honest Answer&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Celestine is silent for a long time. &amp;quot;Yes. We might lose her. I won't lie to you.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Jack in. &lt;b&gt;&amp;gt; F1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="1430" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="V13" value="&lt;b&gt;V13. Dead Hotel&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You hide on the 30th floor of an unfinished hotel, wind howling through empty windows. Mirage: &amp;quot;We can't run forever.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go back to the Voodoo Boys. &lt;b&gt;&amp;gt; V6&lt;/b&gt;&lt;br&gt;2. Call Arasaka. &lt;b&gt;&amp;gt; R1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="1430" y="750" width="240" height="190" as="geometry"/></mxCell><mxCell id="V14" value="&lt;b&gt;V14. Drone Chase&lt;/b&gt;&lt;hr&gt;&lt;i&gt;NetWatch drones scream over the rooftops. You sprint through concrete skeletons, sliding under rebar.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Hide in the hotel. &lt;b&gt;&amp;gt; V13&lt;/b&gt;&lt;br&gt;2. Steal a bike and ride for the Badlands. &lt;b&gt;&amp;gt; N1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="pacifica"><mxGeometry x="1430" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="R1" value="&lt;b&gt;R1. The Offer&lt;/b&gt;&lt;hr&gt;&lt;i&gt;An Arasaka AV drops you at a facility on the Watson waterfront. A cold, polite man waits: Ishida, counter-intelligence.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Accept. &lt;b&gt;&amp;gt; R2&lt;/b&gt;&lt;br&gt;2. Negotiate. &lt;b&gt;&amp;gt; R3&lt;/b&gt;&lt;br&gt;3. Refuse. &lt;b&gt;&amp;gt; R4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="30" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="R2" value="&lt;b&gt;R2. Soulkiller&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Ishida leads you to a lab. &amp;quot;Our engineers will copy the fragment using Soulkiller. Then the shard - and your part in...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go through with it. &lt;b&gt;&amp;gt; R5&lt;/b&gt;&lt;br&gt;2. Hesitate. &lt;b&gt;&amp;gt; R6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="310" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="R3" value="&lt;b&gt;R3. Negotiation&lt;/b&gt;&lt;hr&gt;&lt;i&gt;&amp;quot;100,000,&amp;quot; you say. Ishida smiles thinly. &amp;quot;You are on Arasaka property. Here, you negotiate with your life.&amp;quot; Then:...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &amp;quot;Deal.&amp;quot; &lt;b&gt;&amp;gt; R2&lt;/b&gt;&lt;br&gt;2. Keep pushing. &lt;b&gt;&amp;gt; X12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="310" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="R4" value="&lt;b&gt;R4. Refusal&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Guards in Arasaka armor raise their rifles. Ishida sighs. &amp;quot;Then we take it from your skull.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Fight. &lt;b&gt;&amp;gt; X7&lt;/b&gt;&lt;br&gt;2. &amp;quot;Mirage - now!&amp;quot; &lt;b&gt;&amp;gt; R7&lt;/b&gt;&lt;br&gt;3. &amp;quot;Okay, okay. Deal.&amp;quot; &lt;b&gt;&amp;gt; R2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="310" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="R5" value="&lt;b&gt;R5. The Cage&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The Soulkiller upload starts. Mirage's voice gets smaller and smaller. On a screen you see the file name: PROJECT...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Let it finish. &lt;b&gt;&amp;gt; S4&lt;/b&gt;&lt;br&gt;2. Rip the cables out. &lt;b&gt;&amp;gt; R8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="590" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="R6" value="&lt;b&gt;R6. A Whisper&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A young Arasaka netrunner, Aiko, leans close while Ishida takes a call. &amp;quot;I don't like what they do with things like...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Trust Aiko. &lt;b&gt;&amp;gt; R9&lt;/b&gt;&lt;br&gt;2. Report Aiko to Ishida. &lt;b&gt;&amp;gt; R10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="590" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="R7" value="&lt;b&gt;R7. Quickhack Storm&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Mirage hits every guard at once with Short Circuit. Sparks, screams, alarms. You run.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Up to the AV pad. &lt;b&gt;&amp;gt; R11&lt;/b&gt;&lt;br&gt;2. Down to the server level. &lt;b&gt;&amp;gt; R12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="590" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="R8" value="&lt;b&gt;R8. Pulled Plug&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Sparks fly. The upload dies at 64%. Mirage gasps back into your head. Guards rush in - and a hand pulls you into a...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Follow her. &lt;b&gt;&amp;gt; R9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="870" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="R9" value="&lt;b&gt;R9. Aiko's Route&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Aiko leads you through service tunnels. &amp;quot;Arasaka's research servers here connect close to the Blackwall. If she...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Jack in from the Arasaka servers. &lt;b&gt;&amp;gt; F1&lt;/b&gt;&lt;br&gt;2. Just get out. Go to the roof. &lt;b&gt;&amp;gt; R11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="870" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="R10" value="&lt;b&gt;R10. Loyalty&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Ishida listens, nods, and two guards take Aiko away. She doesn't look at you.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Shake his hand. &lt;b&gt;&amp;gt; S6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="1150" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="R11" value="&lt;b&gt;R11. AV Pad&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You hotwire an Arasaka AV and lift off into the rain. Two security AVs follow.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Fly to the Badlands. &lt;b&gt;&amp;gt; N1&lt;/b&gt;&lt;br&gt;2. Fly to Pacifica. &lt;b&gt;&amp;gt; V1&lt;/b&gt;&lt;br&gt;3. Fly straight over Arasaka airspace down.. &lt;b&gt;&amp;gt; X12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="870" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="R12" value="&lt;b&gt;R12. Server Level&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Freezing air. Endless racks of Arasaka servers glowing red. Mirage: &amp;quot;There's a gate here. I can feel the Wall.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Jack in right now. &lt;b&gt;&amp;gt; F1&lt;/b&gt;&lt;br&gt;2. Smash the servers to slow them down. &lt;b&gt;&amp;gt; X10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="arasaka"><mxGeometry x="870" y="750" width="240" height="190" as="geometry"/></mxCell><mxCell id="N1" value="&lt;b&gt;N1. The Badlands&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Night City shrinks behind you. Desert, dead oil fields, rusted billboards. Out here the Aldecaldos nomads run the...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Head for the Aldecaldos camp. &lt;b&gt;&amp;gt; N2&lt;/b&gt;&lt;br&gt;2. Stop at the Sunset Motel. &lt;b&gt;&amp;gt; N3&lt;/b&gt;&lt;br&gt;3. Take the canyon shortcut. &lt;b&gt;&amp;gt; N4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="30" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="N2" value="&lt;b&gt;N2. Aldecaldos Camp&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Trucks in a circle, a fire, kids, dogs. A scout named Teo raises his rifle. &amp;quot;City folk don't come out here for fun....&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Tell the truth. &lt;b&gt;&amp;gt; N5&lt;/b&gt;&lt;br&gt;2. Lie: &amp;quot;Just passing through.&amp;quot; &lt;b&gt;&amp;gt; N6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="310" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="N3" value="&lt;b&gt;N3. Sunset Motel&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A tired motel by the highway. You rent the last room with what eb you have left. A trucker at the diner offers you a...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Accept the ride. &lt;b&gt;&amp;gt; N2&lt;/b&gt;&lt;br&gt;2. Rest first. &lt;b&gt;&amp;gt; N7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="310" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="N4" value="&lt;b&gt;N4. Wraiths&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Motorbikes roar out of the canyon. Wraiths - raiders in scrap armor, painted skulls on their masks. They surround you.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Fight. &lt;b&gt;&amp;gt; X7&lt;/b&gt;&lt;br&gt;2. Offer them everything you have. &lt;b&gt;&amp;gt; N8&lt;/b&gt;&lt;br&gt;3. &amp;quot;Mirage - their bikes!&amp;quot; &lt;b&gt;&amp;gt; N2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="310" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="N5" value="&lt;b&gt;N5. Family&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Teo lowers the rifle. &amp;quot;Family rule: we help people the corps are hunting.&amp;quot; He takes you to Ines, an old nomad netrunner.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go to the uplink. &lt;b&gt;&amp;gt; N9&lt;/b&gt;&lt;br&gt;2. &amp;quot;Tell me about the old Net.&amp;quot; &lt;b&gt;&amp;gt; N10&lt;/b&gt;&lt;br&gt;3. &amp;quot;Can I just... stay here?&amp;quot; &lt;b&gt;&amp;gt; S5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="870" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="N6" value="&lt;b&gt;N6. Lie Exposed&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Teo scans your face. An NCPD bulletin pops up. &amp;quot;Passing through, huh?&amp;quot; Everyone goes quiet.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Come clean. &lt;b&gt;&amp;gt; N5&lt;/b&gt;&lt;br&gt;2. Walk away into the desert. &lt;b&gt;&amp;gt; N7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="590" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="N7" value="&lt;b&gt;N7. Drone in the Sky&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A black NetWatch drone hovers over you, scanning. Your HUD flashes: TRACE RESUMED.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Shoot it down. &lt;b&gt;&amp;gt; N11&lt;/b&gt;&lt;br&gt;2. Surrender. &lt;b&gt;&amp;gt; X4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="590" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="N8" value="&lt;b&gt;N8. Prisoner&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The Wraiths take your eb, laugh, and throw you into a cage made from an old car. Their boss wants to sell you to...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Wait for a chance. &lt;b&gt;&amp;gt; N2&lt;/b&gt;&lt;br&gt;2. Challenge their boss to a fight. &lt;b&gt;&amp;gt; X7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="590" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="N9" value="&lt;b&gt;N9. The Uplink&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A rusted dish the size of a house, half buried in sand. Ines wires you in. On the horizon - the lights of Arasaka AVs.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Jack in now. &lt;b&gt;&amp;gt; F1&lt;/b&gt;&lt;br&gt;2. Help the nomads fight first. &lt;b&gt;&amp;gt; N12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="1150" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="N10" value="&lt;b&gt;N10. Ines Remembers&lt;/b&gt;&lt;hr&gt;&lt;i&gt;&amp;quot;I was a kid when Bartmoss's viruses ate the Net,&amp;quot; Ines says. &amp;quot;After that, the Net was a graveyard. NetWatch built...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go to the uplink. &lt;b&gt;&amp;gt; N9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="1150" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="N11" value="&lt;b&gt;N11. Drone Down&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The drone crashes into the sand. Mirage reads its memory: &amp;quot;Agent Voss, NetWatch. He's coming himself.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Find the nomads - fast. &lt;b&gt;&amp;gt; N2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="870" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="N12" value="&lt;b&gt;N12. Last Stand&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Trucks form a wall. Nomads fire from the roofs. Teo shouts: &amp;quot;We can't hold long! Do your thing!&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Jack in while they fight. &lt;b&gt;&amp;gt; F1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="badlands"><mxGeometry x="1430" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="F1" value="&lt;b&gt;F1. Jack In&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Your body falls away. You're in the Net - or what's left of it after the DataKrash: broken architecture, floating...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Follow Mirage. &lt;b&gt;&amp;gt; F2&lt;/b&gt;&lt;br&gt;2. Look around on your own. &lt;b&gt;&amp;gt; F3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="30" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="F2" value="&lt;b&gt;F2. Data Ruins&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Ruins of the old Net. Something moves between them - a daemon, a hunting program left over from the Krash.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Fight it. &lt;b&gt;&amp;gt; X13&lt;/b&gt;&lt;br&gt;2. Hide and let it pass. &lt;b&gt;&amp;gt; F4&lt;/b&gt;&lt;br&gt;3. Let Mirage lead you around it. &lt;b&gt;&amp;gt; F5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="310" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="F3" value="&lt;b&gt;F3. Lost Subnet&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You drift into a dead subnet. Walls of black ICE close in around you.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Call for Mirage. &lt;b&gt;&amp;gt; F2&lt;/b&gt;&lt;br&gt;2. Push through. &lt;b&gt;&amp;gt; X10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="310" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="F4" value="&lt;b&gt;F4. Nix's Echo&lt;/b&gt;&lt;hr&gt;&lt;i&gt;In the ruins, a recording: Nix, the netrunner who died in the bar. &amp;quot;If you're hearing this - Mirage isn't dangerous....&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Keep going. &lt;b&gt;&amp;gt; F5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="590" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="F5" value="&lt;b&gt;F5. Agent Voss&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A figure in a grey coat blocks the path: Agent Voss, NetWatch. &amp;quot;Hand her over. The Wall must hold. What's behind it...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Fight Voss. &lt;b&gt;&amp;gt; F6&lt;/b&gt;&lt;br&gt;2. Talk to him. &lt;b&gt;&amp;gt; F7&lt;/b&gt;&lt;br&gt;3. Give Mirage up. &lt;b&gt;&amp;gt; S3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="870" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="F6" value="&lt;b&gt;F6. Duel&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Voss hits you with code that feels like fire. Mirage shields you. &amp;quot;Use me,&amp;quot; she says. &amp;quot;Use all of me.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Use Mirage's full power. &lt;b&gt;&amp;gt; F8&lt;/b&gt;&lt;br&gt;2. Pull back. &lt;b&gt;&amp;gt; F9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1150" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="F7" value="&lt;b&gt;F7. Voss's Truth&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Voss shows you memories: whole cities blacked out, AIs eating people's minds during the Krash. He believes every word.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Try to convince him. &lt;b&gt;&amp;gt; F10&lt;/b&gt;&lt;br&gt;2. Attack while he's distracted. &lt;b&gt;&amp;gt; F6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1150" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="F8" value="&lt;b&gt;F8. Overclock&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You burn through Voss's defenses. He vanishes. But your real body is overheating - your heart monitor screams...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Push through to the Wall. &lt;b&gt;&amp;gt; F11&lt;/b&gt;&lt;br&gt;2. Pull back. &lt;b&gt;&amp;gt; F9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1430" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="F9" value="&lt;b&gt;F9. Fading&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The path to the Wall flickers. Mirage: &amp;quot;Last chance. If we stop now, we never get back here.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Go on. &lt;b&gt;&amp;gt; F11&lt;/b&gt;&lt;br&gt;2. Jack out, right now. &lt;b&gt;&amp;gt; X13&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1430" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="F10" value="&lt;b&gt;F10. Sixty Seconds&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Voss looks at Mirage for a long time. &amp;quot;You have sixty seconds before I report this,&amp;quot; he says, and steps aside.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Run to the Wall. &lt;b&gt;&amp;gt; F11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1430" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="F11" value="&lt;b&gt;F11. The Blackwall&lt;/b&gt;&lt;hr&gt;&lt;i&gt;A wall of red, living code that goes up forever. Voices whisper behind it.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Let her go home. &lt;b&gt;&amp;gt; F12&lt;/b&gt;&lt;br&gt;2. Tear the Wall wide open. &lt;b&gt;&amp;gt; S2&lt;/b&gt;&lt;br&gt;3. Ask her to stay. &lt;b&gt;&amp;gt; F13&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1710" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="F12" value="&lt;b&gt;F12. Something Watches&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Mirage slips through. For a second you see beyond the Wall - and something enormous sees you back. It pushes at the...&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Close the crack. &lt;b&gt;&amp;gt; F14&lt;/b&gt;&lt;br&gt;2. Leave it open. &lt;b&gt;&amp;gt; S2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1990" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="F13" value="&lt;b&gt;F13. Merge&lt;/b&gt;&lt;hr&gt;&lt;i&gt;&amp;quot;If I stay, we become one,&amp;quot; Mirage says. &amp;quot;You won't be fully human anymore. Your body may not survive it.&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Merge with her. &lt;b&gt;&amp;gt; S7&lt;/b&gt;&lt;br&gt;2. Change your mind - let her go. &lt;b&gt;&amp;gt; F12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="1990" y="520" width="240" height="190" as="geometry"/></mxCell><mxCell id="F14" value="&lt;b&gt;F14. Holding the Line&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You throw everything you have at the crack. NetWatch ICE floods in from behind. Your mind is screaming.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Hold it. &lt;b&gt;&amp;gt; F15&lt;/b&gt;&lt;br&gt;2. Let go and run. &lt;b&gt;&amp;gt; X13&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="2270" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="F15" value="&lt;b&gt;F15. Wake Up&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The crack seals. Silence. You wake up gasping, cables in your arms, alive.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Continue. &lt;b&gt;&amp;gt; S1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="blackwall"><mxGeometry x="2270" y="290" width="240" height="190" as="geometry"/></mxCell><mxCell id="S1" value="&lt;b&gt;S1. Home&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Mirage is home, beyond the Wall. The Wall still holds. NetWatch never finds out who did it.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;BEST ENDING&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="endings"><mxGeometry x="30" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="S2" value="&lt;b&gt;S2. Breach&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The Blackwall cracks wide open. Across Night City, screens go white, AVs fall, voices that aren't human speak from...&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DARK ENDING&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="endings"><mxGeometry x="310" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="S3" value="&lt;b&gt;S3. Firewall&lt;/b&gt;&lt;hr&gt;&lt;i&gt;NetWatch deletes Mirage. Voss keeps his word: you walk. A month later he sends you a job offer.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NEUTRAL ENDING&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="endings"><mxGeometry x="590" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="S4" value="&lt;b&gt;S4. Weapon&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Mirage becomes Arasaka's newest weapon against Militech. You get your 50,000 eb.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DARK ENDING&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="endings"><mxGeometry x="870" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="S5" value="&lt;b&gt;S5. Family&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You stay with the Aldecaldos. You learn to fix engines and drive at night. Mirage stays quiet in her shard,...&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GOOD ENDING&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="endings"><mxGeometry x="1150" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="S6" value="&lt;b&gt;S6. Company Man&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You get an Arasaka ID, a corp apartment, and a desk. You never see Aiko again.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DARK ENDING&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="endings"><mxGeometry x="1430" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="S7" value="&lt;b&gt;S7. Ghost in the Net&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Your body flatlines in the chair. But you don't. You and Mirage become something new - part human, part AI, living...&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SECRET ENDING&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="endings"><mxGeometry x="1710" y="60" width="240" height="190" as="geometry"/></mxCell><mxCell id="X1" value="&lt;b&gt;X1. Loose End&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The shard's tracker pings from the trash. NetWatch checks the street cameras and finds you within the hour....&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="60" width="240" height="120" as="geometry"/></mxCell><mxCell id="X2" value="&lt;b&gt;X2. MaxTac&lt;/b&gt;&lt;hr&gt;&lt;i&gt;NCPD calls in MaxTac for the cyberpsycho. MaxTac doesn't ask who's a bystander.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="488" width="240" height="120" as="geometry"/></mxCell><mxCell id="X3" value="&lt;b&gt;X3. Fried Synapses&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The shard comes out. So does the NetWatch trace - straight into your brain. Everything goes white.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="916" width="240" height="120" as="geometry"/></mxCell><mxCell id="X4" value="&lt;b&gt;X4. Traced&lt;/b&gt;&lt;hr&gt;&lt;i&gt;TRACE 100%. A NetWatch agent you never see burns your brain through your own optics.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="1345" width="240" height="120" as="geometry"/></mxCell><mxCell id="X5" value="&lt;b&gt;X5. Doc's Shotgun&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Doc Mori keeps a shotgun under the operating table. Of course she does.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="1773" width="240" height="120" as="geometry"/></mxCell><mxCell id="X6" value="&lt;b&gt;X6. Chrome Hungry&lt;/b&gt;&lt;hr&gt;&lt;i&gt;The Maelstrom boss slots the shard, laughs, and decides your chrome would look better on him.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="2202" width="240" height="120" as="geometry"/></mxCell><mxCell id="X7" value="&lt;b&gt;X7. Outgunned&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Brave. Very brave. Also very, very outnumbered. Night City eats people like you every night.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="2630" width="240" height="120" as="geometry"/></mxCell><mxCell id="X8" value="&lt;b&gt;X8. Checkpoint&lt;/b&gt;&lt;hr&gt;&lt;i&gt;NCPD opens fire on the car. The Quadra flips twice and burns on the bridge.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="3059" width="240" height="120" as="geometry"/></mxCell><mxCell id="X9" value="&lt;b&gt;X9. Scavs&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Scavengers catch you in the Combat Zone. They sell your cyberware by the gram.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="3487" width="240" height="120" as="geometry"/></mxCell><mxCell id="X10" value="&lt;b&gt;X10. Black ICE&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Black ICE locks onto your brain. Your heart stops before you even feel it.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="3916" width="240" height="120" as="geometry"/></mxCell><mxCell id="X11" value="&lt;b&gt;X11. Animal Instincts&lt;/b&gt;&lt;hr&gt;&lt;i&gt;You punch an Animal. The Animal does not notice. Then it punches back.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="4344" width="240" height="120" as="geometry"/></mxCell><mxCell id="X12" value="&lt;b&gt;X12. Corporate Termination&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Arasaka doesn't negotiate with people who push too far - or fly over its airspace. Your file is closed: TERMINATED.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="4773" width="240" height="120" as="geometry"/></mxCell><mxCell id="X13" value="&lt;b&gt;X13. Flatline in the Net&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Your mind gets lost in the dead Net. Back in meatspace, your body flatlines in the chair.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GAME OVER&lt;/b&gt; - restart at P1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="gameover"><mxGeometry x="30" y="5201" width="240" height="120" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P1" target="P3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P2" target="P4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P2" target="P7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P2" target="P5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P3" target="P4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P3" target="P6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P3" target="P5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P4" target="P8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P4" target="P9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontStyle=1;strokeColor=#8A94A6;" edge="1" parent="prologue" source="P4" target="P5"><mxGeometry relative="1" as="geometry